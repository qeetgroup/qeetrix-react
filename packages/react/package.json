{
  "name": "@qeetrix/react",
  "version": "0.0.2",
  "description": "Qeetrix React components: accessible, token-driven primitives on Base UI for every Qeet product.",
  "keywords": [
    "qeetrix",
    "design-system",
    "react",
    "components",
    "base-ui",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeetrix-react#readme",
  "bugs": {
    "url": "https://github.com/qeetgroup/qeetrix-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeetrix-react.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/styles.css",
      "default": "./dist/index.js"
    },
    "./box": {
      "types": "./dist/box/index.d.ts",
      "default": "./dist/box/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "default": "./dist/checkbox/index.js"
    },
    "./field": {
      "types": "./dist/field/index.d.ts",
      "default": "./dist/field/index.js"
    },
    "./fieldset": {
      "types": "./dist/fieldset/index.d.ts",
      "default": "./dist/fieldset/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./heading": {
      "types": "./dist/heading/index.d.ts",
      "default": "./dist/heading/index.js"
    },
    "./inline": {
      "types": "./dist/inline/index.d.ts",
      "default": "./dist/inline/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    },
    "./link": {
      "types": "./dist/link/index.d.ts",
      "default": "./dist/link/index.js"
    },
    "./radio": {
      "types": "./dist/radio/index.d.ts",
      "default": "./dist/radio/index.js"
    },
    "./separator": {
      "types": "./dist/separator/index.d.ts",
      "default": "./dist/separator/index.js"
    },
    "./skip-link": {
      "types": "./dist/skip-link/index.d.ts",
      "default": "./dist/skip-link/index.js"
    },
    "./spinner": {
      "types": "./dist/spinner/index.d.ts",
      "default": "./dist/spinner/index.js"
    },
    "./stack": {
      "types": "./dist/stack/index.d.ts",
      "default": "./dist/stack/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "default": "./dist/switch/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./text-field": {
      "types": "./dist/text-field/index.d.ts",
      "default": "./dist/text-field/index.js"
    },
    "./toggle": {
      "types": "./dist/toggle/index.d.ts",
      "default": "./dist/toggle/index.js"
    },
    "./visually-hidden": {
      "types": "./dist/visually-hidden/index.d.ts",
      "default": "./dist/visually-hidden/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./css/*": "./dist/css/*",
    "./package.json": "./package.json"
  },
  "style": "./dist/styles.css",
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api": "api-extractor run --local",
    "check": "bun run check:source && bun run check:dist && bun run check:api && bun run check:package",
    "check:source": "node scripts/check-source.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:api": "api-extractor run",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./css/*",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@qeetrix/icons": "^1.0.12"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@qeetrix/tokens": "^0.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "publint": "^0.3.25",
    "@arethetypeswrong/cli": "^0.18.5"
  }
}

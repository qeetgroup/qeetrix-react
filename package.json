{
  "name": "qeetrix-react-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@qeetrix/react' build",
    "typecheck": "bun run --filter '@qeetrix/react' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run --filter '@qeetrix/react' test",
    "check:package": "bun run --filter '@qeetrix/react' check:package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "lightningcss": "^1.33.0",
    "tsdown": "0.23.2",
    "typescript": "^7.0.2"
  }
}

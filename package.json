{
  "name": "qeetrix-react-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@qeetrix/react' build",
    "typecheck": "bun run --filter '@qeetrix/react' typecheck",
    "lint": "biome check .",
    "lint:compiler": "node tools/eslint/node_modules/eslint/bin/eslint.js --config tools/eslint/eslint.config.js --max-warnings 0 packages/*/src packages/*/tests",
    "format": "biome check --write .",
    "test": "bun run --filter '@qeetrix/react' test",
    "test:coverage": "bun run --filter '@qeetrix/react' test:coverage",
    "check": "bun run --filter '@qeetrix/react' check",
    "check:package": "bun run --filter '@qeetrix/react' check:package"
  },
  "devDependencies": {
    "@argos-ci/vitest": "^0.9.0",
    "@base-ui/react": "^1.9.0",
    "@biomejs/biome": "2.6.6",
    "@microsoft/api-extractor": "^7.60.1",
    "@qeetrix/icons": "^2.1.2",
    "@qeetrix/tokens": "^0.0.15",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "lightningcss": "^1.33.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
